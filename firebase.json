{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".cdc/**",
      ".firebase/**",
      "*.backup",
      "firebase-debug.log",
      "firestore.indexes.json",
      "firestore.rules",
      "functions/**",
      "CHANGELOG.md",
      "DECISIONS.md",
      "NEXT.md",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}

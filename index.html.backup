<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MORELOS TRABAJA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- Cargamos Firebase v8 (Más estable para previos) -->
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-auth.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-functions.js"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .hero-gradient {
            background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.8)), 
                        url('https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&q=80&w=1200');
            background-size: cover; background-position: center;
        }
        /* La clase card-anuncio ahora usa border-l-[6px] y el color se asigna dinámicamente con clases de Tailwind */
        .card-anuncio { 
            transition: all 0.3s ease; 
        }
        .card-anuncio:hover { 
            transform: translateY(-4px); 
            box-shadow: 0 15px 30px rgba(0,0,0,0.1); 
        }
        .article-content h3 {
            color: #172554;
            font-size: 1.25rem;
            font-weight: 900;
            line-height: 1.35;
            margin-top: 2rem;
            margin-bottom: 0.75rem;
        }
        .article-content p,
        .article-content li {
            color: #475569;
            line-height: 1.75;
        }
        .article-content p + p { margin-top: 1rem; }
        .article-content ul,
        .article-content ol {
            display: grid;
            gap: 0.75rem;
            margin: 1rem 0;
            padding-left: 1.5rem;
        }
        .article-content ul { list-style: disc; }
        .article-content ol { list-style: decimal; }
    </style>
</head>
<body class="bg-slate-50 min-h-screen">

    <div id="auth-overlay" class="fixed inset-0 z-[100] bg-slate-950/70 backdrop-blur-sm flex items-center justify-center p-5" aria-live="polite">
        <section class="bg-white w-full max-w-md rounded-[2rem] shadow-2xl p-7 md:p-9" aria-labelledby="auth-title">
            <div id="auth-resolving" class="py-16 text-center">
                <div class="animate-spin rounded-full h-12 w-12 border-4 border-blue-100 border-t-blue-600 mx-auto"></div>
                <p class="mt-4 text-slate-500 font-bold text-sm">Comprobando tu sesión...</p>
            </div>
            <div id="auth-content" class="hidden">
                <p class="text-xs font-black tracking-[0.25em] text-blue-600 uppercase">Morelos Trabaja</p>
                <h2 id="auth-title" class="text-3xl font-black text-blue-950 mt-2">Crea tu cuenta</h2>
                <p id="auth-subtitle" class="text-slate-500 mt-2 mb-7">Regístrate para continuar.</p>
                <form id="auth-form" class="space-y-4">
                    <label class="block text-sm font-bold text-slate-700">Correo electrónico
                        <input id="auth-email" type="email" autocomplete="email" required class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="tu@correo.com">
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Contraseña
                        <input id="auth-password" type="password" autocomplete="new-password" required minlength="6" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Mínimo 6 caracteres">
                    </label>
                    <p id="auth-message" role="status" class="hidden rounded-xl px-4 py-3 text-sm font-bold"></p>
                    <button id="auth-submit" type="submit" class="w-full rounded-xl bg-blue-700 py-3.5 font-black text-white hover:bg-blue-800 disabled:cursor-not-allowed disabled:opacity-60">CREAR CUENTA</button>
                </form>
                <div class="my-5 flex items-center gap-3 text-xs font-bold text-slate-400">
                    <span class="h-px flex-1 bg-slate-200"></span>O CONTINÚA CON<span class="h-px flex-1 bg-slate-200"></span>
                </div>
                <button id="google-login" type="button" class="w-full rounded-xl border border-slate-300 bg-white py-3.5 font-black text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-60">
                    <i class="fab fa-google mr-2 text-red-500" aria-hidden="true"></i> GOOGLE
                </button>
                <div class="mt-5 flex flex-col items-center gap-3 text-sm">
                    <button id="auth-reset" type="button" class="font-bold text-blue-700 hover:underline disabled:opacity-60">Olvidé mi contraseña</button>
                    <button id="auth-toggle" type="button" class="text-slate-600 disabled:opacity-60">Ya tengo cuenta. <span class="font-black text-blue-700">Iniciar sesión</span></button>
                </div>
            </div>
        </section>
    </div>

    <!-- Nuevo Overlay para Publicar Anuncios -->
    <div id="publish-overlay" class="fixed inset-0 z-[101] bg-slate-950/70 backdrop-blur-sm flex items-center justify-center p-5 hidden" aria-live="polite">
        <section class="bg-white w-full max-w-lg rounded-[2rem] shadow-2xl p-7 md:p-9 relative max-h-[90vh] overflow-y-auto" aria-labelledby="publish-title">
            <button onclick="hidePublishOverlay()" class="absolute top-4 right-4 text-slate-500 hover:text-slate-700">
                <i class="fas fa-times text-xl"></i>
            </button>
            <p class="text-xs font-black tracking-[0.25em] text-red-600 uppercase">Publicar Anuncio</p>
            <h2 id="publish-title" class="text-3xl font-black text-blue-950 mt-2">¿Qué quieres publicar?</h2>
            <p id="publish-subtitle" class="text-slate-500 mt-2 mb-7">Selecciona la categoría de tu anuncio.</p>

            <div id="category-selection" class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
                <button onclick="showSpecificPublishForm('empleo')" class="bg-blue-50 text-blue-800 p-4 rounded-xl font-bold flex flex-col items-center hover:bg-blue-100 transition-all">
                    <span class="text-3xl mb-2">💼</span>Empleo
                </button>
                <button onclick="showSpecificPublishForm('servicios')" class="bg-emerald-50 text-emerald-800 p-4 rounded-xl font-bold flex flex-col items-center hover:bg-emerald-100 transition-all">
                    <span class="text-3xl mb-2">🛠️</span>Servicio
                </button>
                <button onclick="showSpecificPublishForm('ventas')" class="bg-purple-50 text-purple-800 p-4 rounded-xl font-bold flex flex-col items-center hover:bg-purple-100 transition-all">
                    <span class="text-3xl mb-2">🛍️</span>Venta
                </button>
            </div>

            <div id="publish-forms-container">
                <!-- Empleo Form -->
                <form id="form-empleo" class="space-y-4 hidden">
                    <h3 class="text-2xl font-black text-blue-950 mt-2">Publicar Empleo</h3>
                    <p class="text-slate-500 mb-4">Ingresa los detalles del puesto que ofreces.</p>
                    <label class="block text-sm font-bold text-slate-700">Título del Anuncio
                        <input type="text" id="empleo-titulo" required minlength="4" maxlength="80" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Ej: Chef para restaurante">
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Descripción del Puesto
                        <textarea id="empleo-descripcion" required minlength="10" maxlength="500" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" rows="3" placeholder="Funciones, requisitos, beneficios..."></textarea>
                    </label>
                    <label class="block text-sm font-bold text-slate-700">WhatsApp de Contacto (10-15 dígitos)
                        <input type="tel" id="empleo-whatsapp" required inputmode="tel" pattern="[0-9 +()-]{10,20}" maxlength="20" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Ej: 5217771234567">
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Zona de Trabajo
                        <input type="text" id="empleo-zona" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Ej: Cuernavaca, Centro / Home Office">
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Nombre de la Empresa (opcional)
                        <input type="text" id="empleo-empresa" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Ej: Restaurante El Sabor">
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Tipo de Empleo
                        <select id="empleo-tipo-empleo" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="">Selecciona</option>
                            <option value="permanente">Permanente</option>
                            <option value="temporal">Temporal</option>
                            <option value="por_contrato">Por Contrato</option>
                            <option value="por_proyecto">Por Proyecto</option>
                            <option value="freelance">Freelance</option>
                            <option value="temporada">Temporada</option>
                        </select>
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Área de Trabajo
                        <select id="empleo-area-trabajo" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="">Selecciona</option>
                            <option value="administracion">Administración</option>
                            <option value="alimentos_bebidas">Alimentos y Bebidas</option>
                            <option value="automotriz">Automotriz</option>
                            <option value="contabilidad_finanzas">Contabilidad / Finanzas</option>
                            <option value="construccion">Construcción</option>
                            <option value="diseno">Diseño</option>
                            <option value="educacion">Educación</option>
                            <option value="informatica_it">Informática / IT</option>
                            <option value="jardineria">Jardinería</option>
                            <option value="legal">Legal</option>
                            <option value="mantenimiento">Mantenimiento</option>
                            <option value="manufactura">Manufactura</option>
                            <option value="marketing">Marketing</option>
                            <option value="medicina_salud">Medicina / Salud</option>
                            <option value="recursos_humanos">Recursos Humanos</option>
                            <option value="restauracion">Restauración</option>
                            <option value="servicio_cliente">Servicio al Cliente</option>
                            <option value="ventas">Ventas</option>
                            <option value="otros">Otros</option>
                        </select>
                    </label>
                    <p id="empleo-message" role="status" class="hidden rounded-xl px-4 py-3 text-sm font-bold"></p>
                    <button type="submit" class="w-full rounded-xl bg-blue-700 py-3.5 font-black text-white hover:bg-blue-800 disabled:cursor-not-allowed disabled:opacity-60">PUBLICAR EMPLEO</button>
                    <button type="button" onclick="showCategorySelection()" class="w-full mt-2 text-sm font-bold text-slate-600 hover:underline">Volver a categorías</button>
                </form>

                <!-- Servicio Form -->
                <form id="form-servicios" class="space-y-4 hidden">
                    <h3 class="text-2xl font-black text-emerald-950 mt-2">Publicar Servicio</h3>
                    <p class="text-slate-500 mb-4">Ingresa los detalles del servicio que ofreces.</p>
                    <label class="block text-sm font-bold text-slate-700">Título del Servicio
                        <input type="text" id="servicios-titulo" required minlength="4" maxlength="80" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-emerald-500" placeholder="Ej: Plomero a domicilio 24/7">
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Descripción del Servicio
                        <textarea id="servicios-descripcion" required minlength="10" maxlength="500" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-emerald-500" rows="3" placeholder="Detalles de tu servicio, tarifas aproximadas, horarios..."></textarea>
                    </label>
                    <label class="block text-sm font-bold text-slate-700">WhatsApp de Contacto (10-15 dígitos)
                        <input type="tel" id="servicios-whatsapp" required inputmode="tel" pattern="[0-9 +()-]{10,20}" maxlength="20" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-emerald-500" placeholder="Ej: 5217771234567">
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Zona de Servicio
                        <input type="text" id="servicios-zona" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-emerald-500" placeholder="Ej: Cuautla y alrededores">
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Tipo de Servicio
                        <select id="servicios-tipo-servicio" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="">Selecciona</option>
                            <option value="albanileria">Albañilería</option>
                            <option value="carpinteria">Carpintería</option>
                            <option value="clases_particulares">Clases Particulares</option>
                            <option value="contaduria">Contaduría</option>
                            <option value="diseno_grafico">Diseño Gráfico</option>
                            <option value="electricidad">Electricidad</option>
                            <option value="eventos">Eventos (Organización/Servicio)</option>
                            <option value="jardineria">Jardinería</option>
                            <option value="limpieza">Limpieza</option>
                            <option value="mantenimiento">Mantenimiento (General)</option>
                            <option value="plomeria">Plomería</option>
                            <option value="reparacion_electronica">Reparación Electrónica</option>
                            <option value="taxi_transporte">Taxi / Transporte</option>
                            <option value="otros">Otros</option>
                        </select>
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Experiencia / Calificaciones (opcional)
                        <textarea id="servicios-experiencia" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-emerald-500" rows="2" placeholder="Ej: 10 años de experiencia, certificaciones..."></textarea>
                    </label>
                    <p id="servicios-message" role="status" class="hidden rounded-xl px-4 py-3 text-sm font-bold"></p>
                    <button type="submit" class="w-full rounded-xl bg-green-700 py-3.5 font-black text-white hover:bg-green-800 disabled:cursor-not-allowed disabled:opacity-60">PUBLICAR SERVICIO</button>
                    <button type="button" onclick="showCategorySelection()" class="w-full mt-2 text-sm font-bold text-slate-600 hover:underline">Volver a categorías</button>
                </form>

                <!-- Venta Form -->
                <form id="form-ventas" class="space-y-4 hidden">
                    <h3 class="text-2xl font-black text-purple-950 mt-2">Publicar Venta</h3>
                    <p class="text-slate-500 mb-4">Ingresa los detalles del artículo que deseas vender.</p>
                    <label class="block text-sm font-bold text-slate-700">Título del Artículo
                        <input type="text" id="ventas-titulo" required minlength="4" maxlength="80" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-purple-500" placeholder="Ej: Bicicleta de montaña Rodada 29">
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Descripción del Artículo
                        <textarea id="ventas-descripcion" required minlength="10" maxlength="500" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-purple-500" rows="3" placeholder="Características, estado, detalles, motivos de venta..."></textarea>
                    </label>
                    <label class="block text-sm font-bold text-slate-700">WhatsApp de Contacto (10-15 dígitos)
                        <input type="tel" id="ventas-whatsapp" required inputmode="tel" pattern="[0-9 +()-]{10,20}" maxlength="20" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-purple-500" placeholder="Ej: 5217771234567">
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Ubicación del Producto
                        <input type="text" id="ventas-zona" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-purple-500" placeholder="Ej: Jiutepec, Colonia Zapata">
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Precio ($ MXN)
                        <input type="number" id="ventas-precio" required min="0" step="any" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-purple-500" placeholder="Ej: 1500">
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Condición
                        <select id="ventas-condicion" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-purple-500">
                            <option value="">Selecciona</option>
                            <option value="nuevo">Nuevo</option>
                            <option value="usado_excelente">Usado - Excelente</option>
                            <option value="usado_bueno">Usado - Bueno</option>
                            <option value="usado_aceptable">Usado - Aceptable</option>
                            <option value="para_partes">Para Partes</option>
                        </select>
                    </label>
                    <label class="block text-sm font-bold text-slate-700">Tipo de Producto
                        <input type="text" id="ventas-tipo-producto" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-purple-500" placeholder="Ej: Electrónica, Muebles, Ropa, Vehículos, Servicios">
                    </label>
                    <p id="ventas-message" role="status" class="hidden rounded-xl px-4 py-3 text-sm font-bold"></p>
                    <button type="submit" class="w-full rounded-xl bg-purple-700 py-3.5 font-black text-white hover:bg-purple-800 disabled:cursor-not-allowed disabled:opacity-60">PUBLICAR VENTA</button>
                    <button type="button" onclick="showCategorySelection()" class="w-full mt-2 text-sm font-bold text-slate-600 hover:underline">Volver a categorías</button>
                </form>
            </div>
        </section>
    </div>

    <!-- Buscar anuncios -->
    <div id="search-overlay" class="fixed inset-0 z-[101] bg-slate-950/70 backdrop-blur-sm flex items-center justify-center p-5 hidden" aria-live="polite">
        <section class="bg-white w-full max-w-lg rounded-[2rem] shadow-2xl p-7 md:p-9 relative" aria-labelledby="search-title">
            <button onclick="hideSearchOverlay()" class="absolute top-4 right-4 text-slate-500 hover:text-slate-700" aria-label="Cerrar búsqueda"><i class="fas fa-times text-xl"></i></button>
            <p class="text-xs font-black tracking-[0.25em] text-blue-600 uppercase">Buscar anuncios</p>
            <h2 id="search-title" class="text-3xl font-black text-blue-950 mt-2">¿Qué quieres buscar?</h2>
            <p class="text-slate-500 mt-2 mb-7">Selecciona una categoría para ver sus anuncios.</p>
            <div id="search-category-selection" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <button onclick="selectSearchCategory('empleo')" class="bg-blue-50 text-blue-800 p-4 rounded-xl font-bold hover:bg-blue-100"><i class="fas fa-briefcase text-2xl block mb-2"></i>Empleo</button>
                <button onclick="selectSearchCategory('servicios')" class="bg-emerald-50 text-emerald-800 p-4 rounded-xl font-bold hover:bg-emerald-100"><i class="fas fa-tools text-2xl block mb-2"></i>Servicio</button>
                <button onclick="selectSearchCategory('ventas')" class="bg-purple-50 text-purple-800 p-4 rounded-xl font-bold hover:bg-purple-100"><i class="fas fa-tag text-2xl block mb-2"></i>Venta</button>
            </div>
            <form id="search-criteria-form" class="hidden space-y-4">
                <div id="search-fields"></div>
                <button type="submit" class="w-full rounded-xl bg-blue-700 py-3.5 font-black text-white hover:bg-blue-800"><i class="fas fa-search mr-2"></i>BUSCAR</button>
                <button type="button" onclick="showSearchCategories()" class="w-full text-sm font-bold text-slate-600 hover:underline">Volver a categorías</button>
            </form>
        </section>
    </div>

    <!-- About Us Overlay -->
    <div id="about-overlay" class="fixed inset-0 z-[101] bg-slate-950/70 backdrop-blur-sm flex items-center justify-center p-5 hidden" aria-live="polite">
        <section class="bg-white w-full max-w-md rounded-[2rem] shadow-2xl p-7 md:p-9 relative max-h-[90vh] overflow-y-auto" aria-labelledby="about-title">
            <button onclick="hideAboutOverlay()" class="absolute top-4 right-4 text-slate-500 hover:text-slate-700" aria-label="Cerrar"><i class="fas fa-times text-xl"></i></button>
            <h2 id="about-title" class="text-3xl font-black text-blue-950 mt-2">Acerca de Morelos Trabaja</h2>
            <p class="text-slate-500 mt-2 mb-4">
                Morelos Trabaja es un portal comunitario para conectar a personas que buscan empleo, ofrecen servicios o venden productos dentro del estado de Morelos. Nuestra misión es facilitar oportunidades y fortalecer la economía local.
            </p>
            <p class="text-slate-500 mb-4">
                Si encuentras alguna discrepancia en una calificación o tienes alguna sugerencia, no dudes en contactarnos.
            </p>
            <button onclick="contactForGrading()" class="w-full rounded-xl bg-blue-700 py-3.5 font-black text-white hover:bg-blue-800 disabled:cursor-not-allowed disabled:opacity-60 mb-4">
                <i class="fas fa-envelope mr-2"></i> Contactar por calificaciones
            </button>
            <button onclick="hideAboutOverlay(); showArticlesOverlay()" class="w-full block text-center rounded-xl border border-slate-300 bg-white py-3.5 font-black text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-60">
                <i class="fas fa-newspaper mr-2"></i> Ver Artículos de Interés
            </button>
            <p class="text-xs text-slate-400 mt-4 text-center">Versión 36.17 - Desarrollado con ❤️ en Morelos.</p>
        </section>
    </div>

    <!-- Artículos de interés -->
    <div id="articles-overlay" class="fixed inset-0 z-[101] bg-slate-950/70 backdrop-blur-sm flex items-center justify-center p-3 md:p-5 hidden" aria-live="polite">
        <section class="bg-white w-full max-w-4xl rounded-[2rem] shadow-2xl relative max-h-[94vh] overflow-y-auto" aria-labelledby="articles-title">
            <button onclick="hideArticlesOverlay()" class="sticky top-4 z-10 float-right mr-4 md:mr-6 mt-4 h-11 w-11 rounded-full bg-white/95 text-slate-500 shadow-lg ring-1 ring-slate-200 hover:text-blue-700" aria-label="Cerrar artículos de interés">
                <i class="fas fa-times text-xl" aria-hidden="true"></i>
            </button>

            <article class="overflow-hidden">
                <header class="bg-gradient-to-br from-blue-950 via-blue-900 to-blue-700 px-6 py-10 md:px-12 md:py-14 text-white">
                    <p class="text-xs font-black tracking-[0.25em] text-blue-200 uppercase">Artículos de interés · Búsqueda de empleo</p>
                    <h2 id="articles-title" class="mt-4 max-w-3xl text-3xl md:text-5xl font-black leading-tight">Cómo crear un currículum que te ayude a conseguir entrevistas</h2>
                    <p class="mt-5 max-w-2xl text-base md:text-lg leading-relaxed text-blue-100">Una guía sencilla para presentar tu experiencia, destacar tus habilidades y enviar un CV claro y profesional.</p>
                    <div class="mt-6 flex flex-wrap gap-3 text-xs font-bold text-blue-100">
                        <span class="rounded-full bg-white/10 px-3 py-1.5"><i class="far fa-clock mr-2" aria-hidden="true"></i>7 min de lectura</span>
                        <span class="rounded-full bg-white/10 px-3 py-1.5"><i class="far fa-calendar mr-2" aria-hidden="true"></i>11 de agosto de 2026</span>
                    </div>
                </header>

                <div class="article-content px-6 py-8 md:px-12 md:py-12">
                    <p class="text-lg font-medium text-slate-700">Tu currículum es la primera impresión que una empresa recibe de ti. No necesita tener un diseño complicado: debe explicar con rapidez quién eres, qué sabes hacer y por qué eres una buena opción para el puesto.</p>

                    <aside class="my-8 rounded-2xl border border-blue-100 bg-blue-50 p-5 md:p-6">
                        <p class="font-black text-blue-950"><i class="fas fa-lightbulb mr-2 text-amber-500" aria-hidden="true"></i>La regla más importante</p>
                        <p class="mt-2 text-blue-900">Adapta tu currículum a cada vacante. Revisa qué experiencia y habilidades pide la empresa y coloca primero la información que demuestra que cumples con esos requisitos.</p>
                    </aside>

                    <h3>1. Comienza con tus datos de contacto</h3>
                    <p>En la parte superior escribe tu nombre completo, municipio o ciudad, teléfono y correo electrónico. Puedes agregar el enlace a tu portafolio o perfil profesional si es relevante.</p>
                    <p>No incluyas datos sensibles como CURP, RFC, número de seguridad social, domicilio completo o copias de identificaciones. Una empresa seria puede solicitar algunos documentos más adelante, durante el proceso formal de contratación.</p>

                    <h3>2. Escribe un perfil profesional breve</h3>
                    <p>Resume en tres o cuatro líneas tu experiencia, tus principales habilidades y el tipo de oportunidad que buscas. Evita frases genéricas y menciona algo concreto que te diferencie.</p>
                    <div class="my-5 rounded-2xl border-l-4 border-emerald-500 bg-emerald-50 p-5">
                        <p class="text-sm font-black uppercase tracking-wide text-emerald-800">Ejemplo</p>
                        <p class="mt-2 text-emerald-950">Auxiliar administrativo con tres años de experiencia en atención a clientes, control de documentos y manejo de Excel. Organizado, puntual y con facilidad para resolver problemas. Busco integrarme a una empresa de Cuernavaca o Jiutepec.</p>
                    </div>

                    <h3>3. Ordena tu experiencia laboral</h3>
                    <p>Empieza por tu empleo más reciente. Para cada puesto incluye nombre de la empresa o negocio, cargo, fechas y entre tres y cinco actividades o logros. Usa verbos directos como atendí, organicé, vendí, coordiné, reparé o mejoré.</p>
                    <p>Siempre que sea posible, agrega resultados medibles: “atendí a 30 clientes al día”, “reduje los tiempos de entrega” o “superé la meta mensual de ventas”. Si trabajaste por tu cuenta, en un negocio familiar o por proyecto, esa experiencia también cuenta.</p>

                    <h3>4. Incluye tu formación</h3>
                    <p>Escribe primero el nivel de estudios más reciente: carrera, especialidad, bachillerato o secundaria, según corresponda. Indica la institución y el periodo. Si todavía estudias, utiliza “en curso” y tu semestre o fecha estimada de término.</p>
                    <p>Agrega cursos y certificaciones relacionados con la vacante, especialmente si fortalecen habilidades técnicas, digitales, de seguridad, ventas, idiomas u oficio.</p>

                    <h3>5. Destaca habilidades relevantes</h3>
                    <p>Combina conocimientos técnicos con habilidades personales que puedas demostrar. Elige entre seis y diez y evita llenar el documento con cualidades que no se relacionan con el empleo.</p>
                    <ul>
                        <li><strong class="text-slate-800">Habilidades técnicas:</strong> Excel, manejo de caja, inventarios, soldadura, cocina, redes sociales, conducción o mantenimiento.</li>
                        <li><strong class="text-slate-800">Habilidades personales:</strong> comunicación, organización, trabajo en equipo, puntualidad, iniciativa o atención al detalle.</li>
                        <li><strong class="text-slate-800">Idiomas:</strong> menciona tu nivel de forma honesta: básico, intermedio o avanzado.</li>
                    </ul>

                    <h3>6. Cuida la presentación</h3>
                    <ol>
                        <li>Procura que tenga una página si cuentas con poca experiencia y no más de dos si tu trayectoria es amplia.</li>
                        <li>Usa una tipografía fácil de leer, títulos claros, espacios suficientes y el mismo estilo en todo el documento.</li>
                        <li>Revisa ortografía, teléfono y correo. Pide a otra persona que lo lea antes de enviarlo.</li>
                        <li>Guárdalo en PDF para que el formato no cambie y nómbralo de manera profesional: <strong class="text-slate-800">CV_Nombre_Apellido.pdf</strong>.</li>
                    </ol>

                    <h3>7. Si aún no tienes experiencia</h3>
                    <p>Da prioridad a tu formación, servicio social, prácticas, voluntariado, proyectos escolares, trabajos temporales y habilidades. Explica qué hiciste y qué aprendiste. Un proyecto bien descrito puede demostrar responsabilidad, conocimientos y capacidad para colaborar.</p>

                    <h3>Errores que debes evitar</h3>
                    <ul>
                        <li>Enviar el mismo currículum a todas las vacantes sin adaptarlo.</li>
                        <li>Incluir información falsa o exagerar el nivel de una habilidad.</li>
                        <li>Usar fotografías informales, correos poco profesionales o demasiados colores.</li>
                        <li>Escribir párrafos muy largos o dejar fechas y datos de contacto desactualizados.</li>
                        <li>Compartir documentos personales antes de verificar a la empresa y la oferta.</li>
                    </ul>

                    <div class="mt-10 rounded-3xl bg-slate-950 p-6 md:p-8 text-white">
                        <h3 class="!mt-0 !text-white">Lista final antes de enviarlo</h3>
                        <ul class="!mb-0 marker:text-emerald-400">
                            <li class="!text-slate-200">Mis datos de contacto están actualizados.</li>
                            <li class="!text-slate-200">El perfil y las habilidades corresponden a la vacante.</li>
                            <li class="!text-slate-200">La experiencia está ordenada de la más reciente a la más antigua.</li>
                            <li class="!text-slate-200">El documento no tiene faltas de ortografía.</li>
                            <li class="!text-slate-200">El archivo está guardado en PDF con un nombre profesional.</li>
                        </ul>
                    </div>

                    <p class="mt-8 text-sm border-t border-slate-200 pt-6">Un currículum claro facilita que la persona reclutadora encuentre lo importante. Actualízalo cada vez que aprendas una habilidad, termines un curso o consigas un nuevo logro.</p>
                </div>
            </article>
        </section>
    </div>

    <!-- Admin Tools Overlay -->
    <div id="admin-overlay" class="fixed inset-0 z-[101] bg-slate-950/70 backdrop-blur-sm flex items-center justify-center p-5 hidden" aria-live="polite">
        <section class="bg-white w-full max-w-3xl rounded-[2rem] shadow-2xl p-7 md:p-9 relative max-h-[90vh] overflow-y-auto" aria-labelledby="admin-title">
            <button onclick="hideAdminOverlay()" class="absolute top-4 right-4 text-slate-500 hover:text-slate-700" aria-label="Cerrar"><i class="fas fa-times text-xl"></i></button>
            <h2 id="admin-title" class="text-3xl font-black text-red-950 mt-2">Administrar usuarios</h2>
            <p class="text-slate-500 mt-2 mb-5">Selecciona una o varias cuentas para eliminarlas de Authentication y borrar sus anuncios y calificaciones.</p>
            <div class="flex flex-wrap gap-3 mb-4">
                <button type="button" onclick="toggleAllUsers(true)" class="text-sm font-bold text-blue-700 hover:underline">Seleccionar todos</button>
                <button type="button" onclick="toggleAllUsers(false)" class="text-sm font-bold text-slate-600 hover:underline">Limpiar selección</button>
                <button id="delete-users-button" type="button" onclick="deleteSelectedUsers()" class="ml-auto rounded-xl bg-red-700 px-4 py-2 font-black text-white hover:bg-red-800 disabled:opacity-60">Eliminar seleccionados</button>
            </div>
            <div id="admin-users-list" class="space-y-2"><p class="text-slate-500">Cargando usuarios...</p></div>
            <p id="admin-message" role="status" class="hidden rounded-xl px-4 py-3 text-sm font-bold mt-4"></p>
        </section>
    </div>

    <!-- Cabecera integrada en la página -->
    <header class="hero-gradient min-h-[430px] px-6 py-6 text-white">
        <!-- Top Bar Container -->
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 mb-8">
            <!-- Left: Session Info -->
            <div class="flex items-center gap-2 min-w-0">
                <button id="logout-button" type="button" class="hidden bg-blue-700 hover:bg-blue-800 text-white font-bold py-1 px-3 rounded-xl text-xs transition-colors">SALIR</button>
                <span id="session-email" class="hidden block truncate text-sm font-bold text-blue-100"></span>
            </div>

            <!-- Right: Buttons -->
            <div class="flex flex-col sm:flex-row items-center gap-2 shrink-0">
                <button id="about-us-button" class="bg-blue-700 hover:bg-blue-800 text-white font-bold py-2 px-4 rounded-xl text-sm transition-colors whitespace-nowrap">Acerca de nosotros</button>
                <button id="articles-button" class="bg-blue-700 hover:bg-blue-800 text-white font-bold py-2 px-4 rounded-xl text-sm transition-colors whitespace-nowrap">Artículos de interés</button>
                <button id="admin-tools-button" class="hidden bg-red-700 hover:bg-red-800 text-white font-bold py-2 px-4 rounded-xl text-sm transition-colors whitespace-nowrap">Admin Tools</button>
            </div>
        </div>
        <!-- Main Hero Content -->
        <div class="max-w-3xl mx-auto pt-16 text-center">
            <h1 class="text-4xl md:text-6xl font-black mb-2 leading-tight">Morelos Trabaja — VERSION 36.18</h1>
            <p class="text-[10px] font-bold uppercase tracking-widest text-blue-200 mb-6">Versión 36.17</p>
            <h2 class="text-2xl md:text-3xl font-black mb-6 leading-tight">
                El portal de empleos, servicios y ventas en Morelos.
            </h2>
            <p class="text-blue-100 text-lg mb-10 font-medium italic opacity-80">
                "Oportunidades reales para Yautepec, Cuautla y todo el estado."
            </p>
            <div class="flex flex-col md:flex-row gap-4 justify-center">
                <button onclick="showPublishOverlay()" class="bg-red-600 text-white px-10 py-4 rounded-2xl font-black text-lg shadow-2xl hover:bg-red-700 transition-all uppercase tracking-widest">
                    <i class="fas fa-bullhorn mr-2"></i>Publicar
                </button>
                <button onclick="showSearchOverlay()" class="bg-white text-blue-950 px-10 py-4 rounded-2xl font-black text-lg shadow-2xl hover:bg-blue-50 transition-all uppercase tracking-widest">
                    <i class="fas fa-search mr-2"></i>Buscar
                </button>
            </div>
        </div>
    </header>

    <!-- Lista de Anuncios -->
    <main class="max-w-6xl mx-auto p-6 mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="contenedor-anuncios">
        <!-- El contenido inicial se cargará aquí (spinner o anuncios) -->
    </main>

    <script>
        // --- Configuración y Constantes ---
        // La apiKey está expuesta en el lado del cliente, lo cual es típico para aplicaciones SPA con Firebase.
        // Asegúrate de que tus Reglas de Seguridad de Firestore (en la consola de Firebase)
        // restrinjan las operaciones de escritura (allow write: if false;) y que
        // hayas configurado las restricciones de API Key en la Consola de Google Cloud
        // para limitar su uso a dominios y APIs específicos.
        const firebaseConfig = {
            apiKey: "AIzaSyBMDAS5Uqig7NzaHP3h2huzRL30Uo5t7rM",
            authDomain: "morelos-trabaja.firebaseapp.com",
            projectId: "morelos-trabaja",
            storageBucket: "morelos-trabaja.firebasestorage.app",
            messagingSenderId: "506981339593",
            appId: "1:506981339593:web:266f12812305d1a92d1818"
        };

        const CATEGORY_STYLES = {
            empleo: {
                borderColorClass: 'border-blue-500',
                tagBgColorClass: 'bg-blue-100',
                tagTextColorClass: 'text-blue-700'
            },
            servicios: {
                borderColorClass: 'border-emerald-500', 
                tagBgColorClass: 'bg-emerald-100', // Corregido para usar 'emerald' para consistencia
                tagTextColorClass: 'text-emerald-700' // Corregido para usar 'emerald' para consistencia
            },
            ventas: {
                borderColorClass: 'border-purple-500',
                tagBgColorClass: 'bg-purple-100',
                tagTextColorClass: 'text-purple-700'
            },
            default: { // Estilos por defecto si la categoría no coincide
                borderColorClass: 'border-slate-300',
                tagBgColorClass: 'bg-slate-100',
                tagTextColorClass: 'text-slate-600'
            }
        };

        const LOADING_SPINNER_HTML = `
            <div class="text-center py-20" id="loading-spinner">
                <div class="animate-spin rounded-full h-12 w-12 border-4 border-blue-100 border-t-blue-600 mx-auto"></div>
                <p class="mt-4 text-slate-400 font-bold uppercase tracking-widest text-xs">Cargando anuncios...</p>
            </div>
        `;

        const NO_ANUNCIOS_HTML = `
            <div class="text-center py-20 text-slate-400 font-bold col-span-full">No hay anuncios aquí todavía.</div>
        `;

        const PREVIEW_MODE_BANNER = `
            <div class="bg-amber-50 p-4 rounded-2xl mb-8 border border-amber-200 text-center text-xs font-bold text-amber-700 col-span-full">
                <i class="fa fa-info-circle mr-2"></i> MODO VISTA PREVIA: Mostrando ejemplos locales.
            </div>
        `;

        const SUPERUSER_EMAIL = 'cumorahnet@gmail.com';

        function isSuperUser(user = firebase.auth().currentUser) {
            return Boolean(user && user.emailVerified && String(user.email || '').toLowerCase() === SUPERUSER_EMAIL);
        }

        function initializeFirebase() {
            if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
            return firebase.app();
        }

        const GENERIC_ERROR_MESSAGES = {
            'auth/email-already-in-use': 'Ese correo ya tiene una cuenta. Inicia sesión.',
            'auth/invalid-email': 'Escribe un correo electrónico válido.',
            'auth/weak-password': 'La contraseña debe tener al menos 6 caracteres.',
            'auth/wrong-password': 'El correo o la contraseña no son correctos.',
            'auth/user-not-found': 'El correo o la contraseña no son correctos.',
            'auth/invalid-login-credentials': 'El correo o la contraseña no son correctos.',
            'auth/too-many-requests': 'Demasiados intentos. Espera un momento e intenta de nuevo.',
            'auth/network-request-failed': 'No hay conexión. Revisa tu red e intenta de nuevo.',
            'auth/operation-not-allowed': 'Activa el proveedor Correo/Contraseña en Firebase Authentication.',
            'auth/configuration-not-found': 'Firebase Authentication aún no está configurado para este proyecto.',
            'auth/popup-blocked': 'El navegador bloqueó la ventana de Google. Permite ventanas emergentes e intenta de nuevo.',
            'auth/popup-closed-by-user': 'Se cerró la ventana de Google antes de completar el acceso.',
            'auth/account-exists-with-different-credential': 'Ese correo ya está registrado con otro método de acceso.',
            'auth/unauthorized-domain': 'Este dominio no está autorizado en Firebase para iniciar sesión con Google.',
            'permission-denied': 'Permiso denegado. Revisa las Reglas de Seguridad de Firestore para permitir la escritura.',
            'auth/requires-account': 'Inicia sesión con correo o Google para publicar.',
            'form/invalid-ad': 'Revisa el título, la descripción y el WhatsApp antes de publicar.'
        };

        function setupAuthentication() {
            initializeFirebase();
            const auth = firebase.auth();
            const overlay = document.getElementById('auth-overlay');
            const resolving = document.getElementById('auth-resolving');
            const content = document.getElementById('auth-content');
            const form = document.getElementById('auth-form');
            const emailInput = document.getElementById('auth-email');
            const passwordInput = document.getElementById('auth-password');
            const submitButton = document.getElementById('auth-submit');
            const toggleButton = document.getElementById('auth-toggle');
            const resetButton = document.getElementById('auth-reset');
            const googleButton = document.getElementById('google-login');
            const title = document.getElementById('auth-title');
            const subtitle = document.getElementById('auth-subtitle');
            const message = document.getElementById('auth-message');
            const sessionEmail = document.getElementById('session-email');
            const logoutButton = document.getElementById('logout-button');
            const adminToolsButton = document.getElementById('admin-tools-button'); // Added reference
            let isRegistering = true;
            let loading = false;

            const showMessage = (text, type = 'error') => {
                message.textContent = text;
                message.className = type === 'success'
                    ? 'rounded-xl px-4 py-3 text-sm font-bold bg-green-50 text-green-700'
                    : 'rounded-xl px-4 py-3 text-sm font-bold bg-red-50 text-red-700';
            };
            const clearMessage = () => {
                message.textContent = '';
                message.className = 'hidden rounded-xl px-4 py-3 text-sm font-bold';
            };
            const setLoading = value => {
                loading = value;
                [emailInput, passwordInput, submitButton, toggleButton, resetButton, googleButton].forEach(control => control.disabled = value);
                submitButton.textContent = value ? 'PROCESANDO...' : (isRegistering ? 'CREAR CUENTA' : 'INICIAR SESIÓN');
            };
            const renderMode = () => {
                clearMessage();
                title.textContent = isRegistering ? 'Crea tu cuenta' : 'Bienvenido de nuevo';
                subtitle.textContent = isRegistering ? 'Regístrate para continuar.' : 'Inicia sesión para continuar.';
                submitButton.textContent = isRegistering ? 'CREAR CUENTA' : 'INICIAR SESIÓN';
                toggleButton.innerHTML = isRegistering
                    ? 'Ya tengo cuenta. <span class="font-black text-blue-700">Iniciar sesión</span>'
                    : 'No tengo cuenta. <span class="font-black text-blue-700">Registrarme</span>';
                passwordInput.autocomplete = isRegistering ? 'new-password' : 'current-password';
            };

            toggleButton.addEventListener('click', () => {
                if (loading) return;
                isRegistering = !isRegistering;
                renderMode();
            });

            form.addEventListener('submit', async event => {
                event.preventDefault();
                if (loading || !form.reportValidity()) return;
                clearMessage();
                setLoading(true);
                try {
                    const email = emailInput.value.trim();
                    if (isRegistering) await auth.createUserWithEmailAndPassword(email, passwordInput.value);
                    else await auth.signInWithEmailAndPassword(email, passwordInput.value);
                } catch (error) {
                    console.error('Firebase Auth:', error.code, error);
                    const errorMessage = GENERIC_ERROR_MESSAGES[error.code] || 'No fue posible completar la operación. Intenta nuevamente.';
                    showMessage(errorMessage);
                } finally {
                    setLoading(false);
                }
            });

            googleButton.addEventListener('click', async () => {
                if (loading) return;
                clearMessage();
                setLoading(true);
                try {
                    const provider = new firebase.auth.GoogleAuthProvider();
                    provider.setCustomParameters({ prompt: 'select_account' });
                    const prefersRedirect = window.matchMedia('(max-width: 767px)').matches;
                    if (prefersRedirect) {
                        await auth.signInWithRedirect(provider);
                        return;
                    }
                    try {
                        await auth.signInWithPopup(provider);
                    } catch (error) {
                        if (error.code === 'auth/popup-blocked') {
                            await auth.signInWithRedirect(provider);
                            return;
                        }
                        throw error;
                    }
                } catch (error) {
                    console.error('Firebase Auth Google:', error.code, error);
                    const errorMessage = error.code === 'auth/unauthorized-domain'
                        ? `Autoriza el dominio ${window.location.hostname} en Firebase Authentication.`
                        : (GENERIC_ERROR_MESSAGES[error.code] || 'No fue posible acceder con Google. Intenta nuevamente.');
                    showMessage(errorMessage);
                } finally {
                    setLoading(false);
                }
            });

            auth.getRedirectResult().catch(error => {
                console.error('Firebase Auth Google redirect:', error.code, error);
                const errorMessage = error.code === 'auth/unauthorized-domain'
                    ? `Autoriza el dominio ${window.location.hostname} en Firebase Authentication.`
                    : (GENERIC_ERROR_MESSAGES[error.code] || 'No fue posible completar el acceso con Google.');
                resolving.classList.add('hidden');
                content.classList.remove('hidden');
                showMessage(errorMessage);
            });

            resetButton.addEventListener('click', async () => {
                if (loading) return;
                const email = emailInput.value.trim();
                if (!email) {
                    showMessage('Escribe tu correo para enviarte el enlace de recuperación.');
                    emailInput.focus();
                    return;
                }
                clearMessage();
                setLoading(true);
                try {
                    await auth.sendPasswordResetEmail(email);
                    isRegistering = false;
                    renderMode();
                    showMessage('Te enviamos un enlace para restablecer tu contraseña.', 'success');
                } catch (error) {
                    console.error('Firebase Auth reset:', error.code, error); // Log full error object
                    const errorMessage = GENERIC_ERROR_MESSAGES[error.code] || 'No fue posible enviar el enlace. Intenta nuevamente.';
                    showMessage(errorMessage);
                } finally {
                    setLoading(false);
                }
            });

            logoutButton.addEventListener('click', async () => {
                logoutButton.disabled = true;
                try { await auth.signOut(); }
                catch (error) { console.error('Firebase Auth signOut:', error.code, error); } // Log full error object
                finally { logoutButton.disabled = false; }
            });

            const unsubscribeAuth = auth.onAuthStateChanged(
                user => {
                    resolving.classList.add('hidden');
                    const registeredUser = user && !user.isAnonymous ? user : null;
                    overlay.classList.toggle('hidden', Boolean(registeredUser));
                    content.classList.toggle('hidden', Boolean(registeredUser));
                    sessionEmail.textContent = registeredUser ? registeredUser.email : '';
                    sessionEmail.classList.toggle('hidden', !registeredUser);
                    logoutButton.classList.toggle('hidden', !registeredUser);

                    const isAdmin = isSuperUser(registeredUser);
                    adminToolsButton.classList.toggle('hidden', !isAdmin);

                    if (registeredUser) {
                        firebase.firestore().collection('usuarios').doc(registeredUser.uid).set({
                            email: registeredUser.email || '',
                            lastLogin: firebase.firestore.FieldValue.serverTimestamp()
                        }, { merge: true }).catch(error => console.warn('No fue posible registrar el perfil:', error.code || error));
                    }

                    if (!registeredUser) emailInput.focus();
                    else filtrar(activeCategory, activeCriteria);
                },
                error => {
                    console.error('Firebase Auth observer:', error.code, error);
                    resolving.classList.add('hidden');
                    content.classList.remove('hidden');
                    showMessage(GENERIC_ERROR_MESSAGES[error.code] || 'No fue posible comprobar tu sesión. Recarga la página.');
                }
            );
            window.addEventListener('pagehide', unsubscribeAuth, { once: true });
        }

        // --- Funciones de Renderizado y Publicación ---

        /**
         * Genera el HTML para una tarjeta de anuncio.
         * @param {object} data - Datos del anuncio (titulo, descripcion, categoria, whatsapp, zona, empresa, tipo_empleo, area_trabajo, tipo_servicio, experiencia_servicio, precio, condicion, tipo_producto).
         * @returns {string} HTML de la tarjeta del anuncio.
         */
        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>'"]/g, character => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
            })[character]);
        }

        function normalizeWhatsapp(value) {
            const digits = String(value ?? '').replace(/\D/g, '');
            return /^\d{10,15}$/.test(digits) ? digits : '';
        }

        let activeCategory = null;
        let activeCriteria = {};

        function renderRating(authorUid, ratingInfo = {}) {
            const average = Number(ratingInfo.average || 0);
            const count = Number(ratingInfo.count || 0);
            const ownRating = Number(ratingInfo.ownRating || 0);
            const currentUid = firebase.apps.length && firebase.auth().currentUser?.uid;
            const canRate = authorUid && currentUid && authorUid !== currentUid;
            const encodedAuthor = encodeURIComponent(authorUid || '');
            const stars = [1, 2, 3, 4, 5].map(value => {
                const selected = value <= (ownRating || Math.round(average));
                const color = selected ? 'text-amber-400' : 'text-slate-300';
                return `<button type="button" ${canRate ? '' : 'disabled'} onclick="rateUser(decodeURIComponent('${encodedAuthor}'), ${value})" class="${color} text-xl leading-none disabled:cursor-default hover:text-amber-400" aria-label="Calificar con ${value} estrella${value === 1 ? '' : 's'}">★</button>`;
            }).join('');
            const summary = count ? `${average.toFixed(1)} de 5 · ${count} calificación${count === 1 ? '' : 'es'}` : 'Sin calificaciones';
            return `<div class="mt-4" aria-label="Calificación del anunciante"><p class="text-xs font-bold text-slate-600 mb-1">Califica tu contacto</p><div class="flex gap-0.5">${stars}</div><p class="text-xs text-slate-500 mt-1">${summary}</p></div>`;
        }

        async function loadRatings(authorUids) {
            const ratings = {};
            const currentUid = firebase.auth().currentUser?.uid;
            await Promise.all([...new Set(authorUids.filter(Boolean))].map(async authorUid => {
                try {
                    const snapshot = await firebase.firestore().collection('calificaciones').where('authorUid', '==', authorUid).get();
                    let total = 0;
                    let ownRating = 0;
                    snapshot.forEach(doc => {
                        const item = doc.data();
                        total += Number(item.rating || 0);
                        if (item.raterUid === currentUid) ownRating = Number(item.rating || 0);
                    });
                    ratings[authorUid] = { average: snapshot.size ? total / snapshot.size : 0, count: snapshot.size, ownRating };
                } catch (error) {
                    console.warn('No fue posible cargar calificaciones:', error.code || error);
                }
            }));
            return ratings;
        }

        async function rateUser(authorUid, rating) {
            const currentUser = firebase.auth().currentUser;
            if (!currentUser || !authorUid || currentUser.uid === authorUid || rating < 1 || rating > 5) return;
            try {
                const ratingId = `${authorUid}_${currentUser.uid}`;
                await firebase.firestore().collection('calificaciones').doc(ratingId).set({
                    authorUid,
                    raterUid: currentUser.uid,
                    rating: Number(rating),
                    updatedAt: firebase.firestore.FieldValue.serverTimestamp()
                });
                await filtrar(activeCategory, activeCriteria);
            } catch (error) {
                console.error('Error al calificar:', error);
                alert(GENERIC_ERROR_MESSAGES[error.code] || 'No fue posible guardar tu calificación.');
            }
        }

        function renderAnuncioCard(data, ratingInfo = {}) {
            const category = String(data.categoria || 'default').toLowerCase();
            const style = CATEGORY_STYLES[category] || CATEGORY_STYLES.default;
            const whatsapp = normalizeWhatsapp(data.whatsapp);

            const zona = escapeHtml(data.zona || '');
            const empresa = escapeHtml(data.empresa || '');
            const tipoEmpleo = escapeHtml(data.tipo_empleo || '');
            const areaTrabajo = escapeHtml(data.area_trabajo || '');
            const tipoServicio = escapeHtml(data.tipo_servicio || '');
            const experienciaServicio = escapeHtml(data.experiencia_servicio || '');
            const precio = data.precio ? `$${Number(data.precio).toLocaleString('es-MX')}` : '';
            const condicion = escapeHtml(data.condicion || '');
            const tipoProducto = escapeHtml(data.tipo_producto || '');
            const adminDeleteButton = isSuperUser() && data.id ? `<button type="button" onclick="deleteAd('${encodeURIComponent(data.id)}')" class="mt-3 rounded-lg bg-red-50 px-3 py-2 text-xs font-black text-red-700 hover:bg-red-100"><i class="fas fa-trash mr-1"></i>ELIMINAR ANUNCIO</button>` : '';

            let specificFieldsHtml = '';

            if (category === 'empleo') {
                if (empresa) specificFieldsHtml += `<p class="text-slate-600 text-xs mt-1"><strong>Empresa:</strong> ${empresa}</p>`;
                if (tipoEmpleo) specificFieldsHtml += `<p class="text-slate-600 text-xs mt-1"><strong>Tipo:</strong> ${tipoEmpleo}</p>`;
                if (areaTrabajo) specificFieldsHtml += `<p class="text-slate-600 text-xs mt-1"><strong>Área:</strong> ${areaTrabajo}</p>`;
                if (zona) specificFieldsHtml += `<p class="text-slate-600 text-xs mt-1"><strong>Zona:</strong> ${zona}</p>`;
            } else if (category === 'servicios') {
                if (tipoServicio) specificFieldsHtml += `<p class="text-slate-600 text-xs mt-1"><strong>Tipo:</strong> ${tipoServicio}</p>`;
                if (experienciaServicio) specificFieldsHtml += `<p class="text-slate-600 text-xs mt-1"><strong>Experiencia:</strong> ${experienciaServicio}</p>`;
                if (zona) specificFieldsHtml += `<p class="text-slate-600 text-xs mt-1"><strong>Zona de Servicio:</strong> ${zona}</p>`;
            } else if (category === 'ventas') {
                if (precio) specificFieldsHtml += `<p class="text-slate-600 text-xs mt-1"><strong>Precio:</strong> ${precio}</p>`;
                if (condicion) specificFieldsHtml += `<p class="text-slate-600 text-xs mt-1"><strong>Condición:</strong> ${condicion}</p>`;
                if (tipoProducto) specificFieldsHtml += `<p class="text-slate-600 text-xs mt-1"><strong>Producto:</strong> ${tipoProducto}</p>`;
                if (zona) specificFieldsHtml += `<p class="text-slate-600 text-xs mt-1"><strong>Ubicación:</strong> ${zona}</p>`;
            }

            const contactLink = whatsapp ? `
                    <a href="https://wa.me/${whatsapp}" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp" class="bg-green-500 text-white p-3 rounded-xl shadow-md hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-green-600 focus:ring-offset-2 flex items-center justify-center">
                        <i class="fab fa-whatsapp text-xl" aria-hidden="true"></i>
                    </a>` : '';

            return `
                <div class="card-anuncio bg-white p-5 rounded-xl shadow-sm flex flex-col justify-between gap-4 border-l-[6px] ${style.borderColorClass}">
                    <div class="min-w-0 flex-grow">
                        <span class="text-[10px] font-black px-2 py-1 ${style.tagBgColorClass} ${style.tagTextColorClass} rounded-full uppercase italic mb-2 inline-block">${escapeHtml(category)}</span>
                        <h3 class="text-xl font-black text-slate-800 tracking-tight">${escapeHtml(data.titulo)}</h3>
                        <p class="text-slate-500 text-sm mt-2">${escapeHtml(data.descripcion)}</p>
                        ${specificFieldsHtml}
                        ${renderRating(data.authorUid, ratingInfo)}
                        ${adminDeleteButton}
                    </div>
                    ${contactLink}
                </div>
            `;
        }

        // Función para mostrar anuncios de ejemplo si falla la conexión o Firebase no está disponible.

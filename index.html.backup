        /**
         * Filtra y muestra anuncios de Firebase Firestore o ejemplos locales.
         * @param {string|null} cat - Categoría para filtrar (empleo, servicios, ventas) o null para todas.
         */
        function normalizeSearchValue(value) {
            return String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
        }

        function matchesCriteria(anuncio, criteria) {
            return Object.entries(criteria).every(([field, expected]) => {
                if (!expected) return true;
                if (field === '_keyword') {
                    const searchable = [anuncio.titulo, anuncio.descripcion, anuncio.area_trabajo, anuncio.tipo_servicio, anuncio.tipo_producto].map(normalizeSearchValue).join(' ');
                    return searchable.includes(normalizeSearchValue(expected));
                }
                const actual = normalizeSearchValue(anuncio[field]);
                return actual.includes(normalizeSearchValue(expected));
            });
        }

        async function filtrar(cat = null, criteria = {}) {
            activeCategory = cat;
            activeCriteria = criteria;
            const cont = document.getElementById('contenedor-anuncios');
            cont.innerHTML = LOADING_SPINNER_HTML; // Muestra el spinner de carga

            // Verifica si Firebase está cargado, si no, muestra ejemplos.
            if (typeof firebase === 'undefined' || typeof firebase.firestore === 'undefined') {
                mostrarEjemplos(cat, criteria);
                return;
            }

            try {
                // Inicializa Firebase si no se ha hecho ya
                initializeFirebase();
                const db = firebase.firestore();
                
                let queryRef = db.collection("anuncios");
                if (cat) {
                    queryRef = queryRef.where("categoria", "==", cat);
                }

                const snapshot = await queryRef.get();
                cont.innerHTML = ''; // Limpia el spinner

                if (snapshot.empty) {
                    cont.innerHTML = NO_ANUNCIOS_HTML;
                    return;
                }

                const anuncios = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() })).filter(data => matchesCriteria(data, criteria)).sort((a, b) => {
                    const fechaA = a.fecha?.toMillis?.() ?? 0;
                    const fechaB = b.fecha?.toMillis?.() ?? 0;
                    return fechaB - fechaA;
                });

                if (!anuncios.length) {
                    cont.innerHTML = NO_ANUNCIOS_HTML;
                    return;
                }

                const ratings = await loadRatings(anuncios.map(data => data.authorUid));
                anuncios.forEach(data => {
                    cont.innerHTML += renderAnuncioCard(data, ratings[data.authorUid] || {});
                });
            } catch (error) {
                console.error("Error al cargar anuncios de Firebase:", error);
                mostrarEjemplos(cat, criteria); // En caso de error, muestra los ejemplos
            }
        }


        // --- Funciones para el flujo de Publicación ---

        const publishOverlay = document.getElementById('publish-overlay');
        const categorySelection = document.getElementById('category-selection');
        const publishFormsContainer = document.getElementById('publish-forms-container');
        const publishTitle = document.getElementById('publish-title');
        const publishSubtitle = document.getElementById('publish-subtitle');
        const searchOverlay = document.getElementById('search-overlay');
        const searchCategorySelection = document.getElementById('search-category-selection');
        const searchCriteriaForm = document.getElementById('search-criteria-form');
        const searchFields = document.getElementById('search-fields');
        let selectedSearchCategory = null;

        function searchInput(label, name, placeholder) {
            return `<label class="block text-sm font-bold text-slate-700 mb-4">${label}<input name="${name}" type="text" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="${placeholder}"></label>`;
        }

        function searchSelect(label, name, sourceId) {
            const options = document.getElementById(sourceId).innerHTML;
            return `<label class="block text-sm font-bold text-slate-700 mb-4">${label}<select name="${name}" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500">${options}</select></label>`;
        }

        function showSearchOverlay() {
            searchOverlay.classList.remove('hidden');
            showSearchCategories();
        }

        function hideSearchOverlay() {
            searchOverlay.classList.add('hidden');
        }

        function showSearchCategories() {
            selectedSearchCategory = null;
            searchCategorySelection.classList.remove('hidden');
            searchCriteriaForm.classList.add('hidden');
            document.getElementById('search-title').textContent = '¿Qué quieres buscar?';
        }

        function selectSearchCategory(category) {
            selectedSearchCategory = category;
            searchCategorySelection.classList.add('hidden');
            searchCriteriaForm.classList.remove('hidden');
            const labels = { empleo: 'Buscar empleos', servicios: 'Buscar servicios', ventas: 'Buscar productos' };
            document.getElementById('search-title').textContent = labels[category];

            let fields = searchInput('Palabra clave', '_keyword', category === 'empleo' ? 'Ej: jardinero, cocinero' : category === 'servicios' ? 'Ej: jardinería, plomería' : 'Ej: juguetes, muebles');
            if (category === 'empleo') {
                fields += searchSelect('Tipo de empleo', 'tipo_empleo', 'empleo-tipo-empleo');
                fields += searchSelect('Área de trabajo', 'area_trabajo', 'empleo-area-trabajo');
                fields += searchInput('Zona de trabajo', 'zona', 'Ej: Cuernavaca');
            } else if (category === 'servicios') {
                fields += searchSelect('Tipo de servicio', 'tipo_servicio', 'servicios-tipo-servicio');
                fields += searchInput('Zona de servicio', 'zona', 'Ej: Cuautla');
            } else {
                fields += searchInput('Tipo de producto', 'tipo_producto', 'Ej: Juguetes, electrónica, ropa');
                fields += searchSelect('Condición', 'condicion', 'ventas-condicion');
                fields += searchInput('Ubicación', 'zona', 'Ej: Jiutepec');
            }
            searchFields.innerHTML = fields;
        }

        searchCriteriaForm.addEventListener('submit', event => {
            event.preventDefault();
            if (!selectedSearchCategory) return;
            const criteria = Object.fromEntries([...new FormData(searchCriteriaForm).entries()].filter(([, value]) => String(value).trim()));
            hideSearchOverlay();
            filtrar(selectedSearchCategory, criteria);
            document.getElementById('contenedor-anuncios').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        function showPublishOverlay() {
            publishOverlay.classList.remove('hidden');
            showCategorySelection();
        }

        function hidePublishOverlay() {
            publishOverlay.classList.add('hidden');
        }

        function showCategorySelection() {
            publishTitle.textContent = '¿Qué quieres publicar?';
            publishSubtitle.textContent = 'Selecciona la categoría de tu anuncio.';
            categorySelection.classList.remove('hidden');
            Array.from(publishFormsContainer.children).forEach(form => form.classList.add('hidden'));
        }

        function showSpecificPublishForm(category) {
            categorySelection.classList.add('hidden');
            Array.from(publishFormsContainer.children).forEach(form => form.classList.add('hidden')); // Hide all forms

            let formToShow;
            let formTitle = '';
            let formSubtitle = '';

            if (category === 'empleo') {
                formToShow = document.getElementById('form-empleo');
                formTitle = 'Publicar Empleo';
                formSubtitle = 'Ingresa los detalles del puesto que ofreces.';
            } else if (category === 'servicios') {
                formToShow = document.getElementById('form-servicios');
                formTitle = 'Publicar Servicio';
                formSubtitle = 'Ingresa los detalles del servicio que ofreces.';
            } else if (category === 'ventas') {
                formToShow = document.getElementById('form-ventas');
                formTitle = 'Publicar Venta';
                formSubtitle = 'Ingresa los detalles del artículo que deseas vender.';
            }

            if (formToShow) {
                publishTitle.textContent = formTitle;
                publishSubtitle.textContent = formSubtitle;
                formToShow.classList.remove('hidden');
            }
        }

        async function submitPublishForm(event, category) {
            event.preventDefault();
            const form = event.target;
            const submitButton = form.querySelector('button[type="submit"]');
            const messageElement = form.querySelector('[role="status"]');

            if (!form.reportValidity()) return;

            submitButton.disabled = true;
            messageElement.textContent = 'Publicando...';
            messageElement.className = 'rounded-xl px-4 py-3 text-sm font-bold bg-blue-50 text-blue-700'; // Neutral message
            messageElement.classList.remove('hidden'); // Ensure message is visible

            try {
                initializeFirebase();
                const currentUser = firebase.auth().currentUser;
                if (!currentUser || currentUser.isAnonymous) {
                    const authError = new Error('Se requiere una cuenta registrada.');
                    authError.code = 'auth/requires-account';
                    throw authError;
                }
                const db = firebase.firestore();
                const titulo = form.querySelector(`#${category}-titulo`).value.trim();
                const descripcion = form.querySelector(`#${category}-descripcion`).value.trim();
                const whatsapp = normalizeWhatsapp(form.querySelector(`#${category}-whatsapp`).value);
                if (titulo.length < 4 || titulo.length > 80 || descripcion.length < 10 || descripcion.length > 500 || !whatsapp) {
                    const validationError = new Error('Los datos del anuncio no cumplen las validaciones.');
                    validationError.code = 'form/invalid-ad';
                    throw validationError;
                }
                const anuncioData = {
                    categoria: category,
                    titulo,
                    descripcion,
                    whatsapp,
                    zona: form.querySelector(`#${category}-zona`).value.trim(),
                    authorUid: currentUser.uid,
                    fecha: firebase.firestore.FieldValue.serverTimestamp()
                };

                if (category === 'empleo') {
                    anuncioData.empresa = form.querySelector('#empleo-empresa').value.trim();
                    anuncioData.tipo_empleo = form.querySelector('#empleo-tipo-empleo').value;
                    anuncioData.area_trabajo = form.querySelector('#empleo-area-trabajo').value;
                } else if (category === 'servicios') {
                    anuncioData.tipo_servicio = form.querySelector('#servicios-tipo-servicio').value;
                    anuncioData.experiencia_servicio = form.querySelector('#servicios-experiencia').value.trim();
                } else if (category === 'ventas') {
                    anuncioData.precio = parseFloat(form.querySelector('#ventas-precio').value);
                    anuncioData.condicion = form.querySelector('#ventas-condicion').value;
                    anuncioData.tipo_producto = form.querySelector('#ventas-tipo-producto').value.trim();
                }

                await db.collection("anuncios").add(anuncioData);

                messageElement.textContent = '¡Anuncio publicado con éxito!';
                messageElement.className = 'rounded-xl px-4 py-3 text-sm font-bold bg-green-50 text-green-700';
                form.reset(); // Limpia el formulario
                filtrar(); // Recarga los anuncios en la página principal
                setTimeout(() => {
                    hidePublishOverlay(); // Cierra el modal después de un éxito
                    showCategorySelection(); // Vuelve a la selección de categoría para el próximo anuncio
                }, 2000);

            } catch (error) {
                console.error("Error al publicar anuncio:", error);
                const errorMessage = GENERIC_ERROR_MESSAGES[error.code] || 'Error al publicar. Revisa la consola para más detalles.';
                messageElement.textContent = errorMessage;
                messageElement.className = 'rounded-xl px-4 py-3 text-sm font-bold bg-red-50 text-red-700';
            } finally {
                submitButton.disabled = false;
            }
        }

        // Asignar event listeners a los formularios de publicación
        document.getElementById('form-empleo').addEventListener('submit', (e) => submitPublishForm(e, 'empleo'));
        document.getElementById('form-servicios').addEventListener('submit', (e) => submitPublishForm(e, 'servicios'));
        document.getElementById('form-ventas').addEventListener('submit', (e) => submitPublishForm(e, 'ventas'));


        // --- New Overlay Functions ---
        function showAboutOverlay() {
            document.getElementById('about-overlay').classList.remove('hidden');
        }

        function hideAboutOverlay() {
            document.getElementById('about-overlay').classList.add('hidden');
        }

        function showArticlesOverlay() {
            const overlay = document.getElementById('articles-overlay');
            overlay.classList.remove('hidden');
            overlay.querySelector('section').scrollTop = 0;
        }

        function hideArticlesOverlay() {
            document.getElementById('articles-overlay').classList.add('hidden');
        }

        function showAdminOverlay() {
            if (!isSuperUser()) return;
            document.getElementById('admin-overlay').classList.remove('hidden');
            document.getElementById('admin-message').classList.add('hidden');
            loadAdminUsers();
        }

        function hideAdminOverlay() {
            document.getElementById('admin-overlay').classList.add('hidden');
        }

        function contactForGrading() {
            window.location.href = 'mailto:equipo.morelostrabaja@example.com?subject=Discrepancia%20en%20Calificación%20o%20Sugerencia&body=Hola%2C%0D%0A%0D%0Escribo%20para...';
        }

        // --- Administración segura ---
        function adminMessage(text, type = 'error') {
            const element = document.getElementById('admin-message');
            element.textContent = text;
            element.className = `rounded-xl px-4 py-3 text-sm font-bold mt-4 ${type === 'success' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'}`;
        }

        function getAdminErrorMessage(error) {
            const code = String(error?.code || '');
            if (code.includes('not-found') || code.includes('unavailable')) {
                return 'El servicio administrativo no está disponible temporalmente. Intenta nuevamente en unos minutos.';
            }
            if (code.includes('internal')) {
                return 'El servidor encontró un error al procesar los usuarios. Intenta nuevamente; si continúa, revisa los registros de Functions.';
            }
            if (code.includes('permission-denied') || code.includes('unauthenticated')) {
                return 'Acceso denegado. Inicia sesión con cumorahnet@gmail.com y verifica el correo.';
            }
            return error?.message || 'No fue posible completar la operación administrativa.';
        }

        async function loadAdminUsers() {
            const list = document.getElementById('admin-users-list');
            list.innerHTML = '<p class="text-slate-500">Cargando usuarios...</p>';
            try {
                const result = await firebase.app().functions().httpsCallable('adminListUsers')();
                const users = result.data.users || [];
                list.innerHTML = users.length ? users.map(user => {
                    const isAdminAccount = String(user.email || '').toLowerCase() === SUPERUSER_EMAIL;
                    return `<label class="flex items-center gap-3 rounded-xl border border-slate-200 p-3 ${isAdminAccount ? 'bg-amber-50' : ''}"><input class="admin-user-checkbox h-5 w-5" type="checkbox" value="${escapeHtml(user.uid)}" ${isAdminAccount ? 'disabled' : ''}><span class="min-w-0"><strong class="block truncate text-slate-800">${escapeHtml(user.email || 'Sin correo')}</strong><small class="text-slate-500">${user.disabled ? 'Cuenta deshabilitada' : 'Cuenta activa'}</small></span>${isAdminAccount ? '<span class="ml-auto text-xs font-black text-amber-700">SUPERUSUARIO</span>' : ''}</label>`;
                }).join('') : '<p class="text-slate-500">No hay usuarios registrados.</p>';
            } catch (error) {
                console.error('Error al listar usuarios:', error);
                list.innerHTML = '<p class="text-red-700">No fue posible cargar los usuarios.</p>';
                adminMessage(getAdminErrorMessage(error));
            }
        }

        function toggleAllUsers(checked) {
            document.querySelectorAll('.admin-user-checkbox:not(:disabled)').forEach(input => { input.checked = checked; });
        }

        async function deleteSelectedUsers() {
            const uids = [...document.querySelectorAll('.admin-user-checkbox:checked')].map(input => input.value);
            if (!uids.length) return adminMessage('Selecciona al menos un usuario.');
            if (!confirm(`¿Eliminar permanentemente ${uids.length} usuario(s), sus anuncios y calificaciones?`)) return;
            const button = document.getElementById('delete-users-button');
            button.disabled = true;
            try {
                const result = await firebase.app().functions().httpsCallable('adminDeleteUsers')({ uids });
                const failedText = result.data.failed ? ` ${result.data.failed} no pudieron eliminarse.` : '';
                adminMessage(`Se eliminaron ${result.data.deleted} usuario(s).${failedText}`, result.data.failed ? 'error' : 'success');
                await loadAdminUsers();
                await filtrar(activeCategory, activeCriteria);
            } catch (error) {
                console.error('Error al eliminar usuarios:', error);
                adminMessage(getAdminErrorMessage(error));
            } finally {
                button.disabled = false;
            }
        }

        async function deleteAd(encodedId) {
            if (!isSuperUser() || !confirm('¿Eliminar este anuncio permanentemente?')) return;
            try {
                await firebase.firestore().collection('anuncios').doc(decodeURIComponent(encodedId)).delete();
                await filtrar(activeCategory, activeCriteria);
            } catch (error) {
                console.error('Error al eliminar anuncio:', error);
                alert('No fue posible eliminar el anuncio.');
            }
        }


        // --- Event Listeners ---
        window.addEventListener('load', () => {
            setupAuthentication();
            filtrar();
            // Assign event listeners for new header buttons
            document.getElementById('about-us-button').addEventListener('click', showAboutOverlay);
            document.getElementById('articles-button').addEventListener('click', showArticlesOverlay);
            document.getElementById('admin-tools-button').addEventListener('click', showAdminOverlay);
        }); // Carga autenticación y anuncios al iniciar la página
    </script>
</body>
</html>